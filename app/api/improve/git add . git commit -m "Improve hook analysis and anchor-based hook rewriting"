  // contrast / reversal
  " but ", "however", "not what", "not really", "is not ", "does not ",
  "most people think", "most creators think", "everyone thinks",
  // consequence / stakes
  " cost", " lost", " destroy", " fail", " ruin", "before it", "by the time",
